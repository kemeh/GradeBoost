rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')) ||
         (request.auth.token.email == "kemehhilary@gmail.com"));
    }

    function isTeacher() {
      return isAuthenticated() && 
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')) ||
         (request.auth.token.email == "kemehhilary@gmail.com"));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Public / System Configuration Collections
    match /system_settings/secrets {
      allow read, write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_languages/{langId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /system_translations/{keyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /landing_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /landing_sections/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Partners & Partner Categories
    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /partner_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Phone verifications (SMS/WhatsApp OTP for login, signup & password reset)
    match /phone_verifications/{verificationId} {
      allow read, create, update: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if (isAuthenticated() && isOwner(userId)) || isAdmin();
      allow update: if (isOwner(userId) && (request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    // User Profiles / Profiles fallback collections
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if (isAuthenticated() && isOwner(userId)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /user_profiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if (isAuthenticated() && isOwner(userId)) || isAdmin();
      allow delete: if isAdmin();
    }

    match /deletedUsers/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /deletedUsersByEmail/{email} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /user_subscriptions/{userId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner(userId) || isAdmin());
      allow write: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Students collection
    match /students/{studentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner(studentId) || isAdmin());
      allow create, update: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isOwner(studentId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Alumni collection
    match /alumni/{alumniId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Ambassadors collection
    match /ambassadors/{ambassadorId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Generic Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Exam Questions
    match /exam_questions/{questionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Daily Drills
    match /daily_drills/{drillId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /dailyDrills/{drillId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Drill Submissions
    match /drill_submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Resources
    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // Quizzes & Mock Exams & Marking Schemes & LMS Videos & PDFs & Discussions
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /marking_schemes/{schemeId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /lms_videos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /lms_pdfs/{pdfId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    match /discussions/{threadId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isTeacher();
    }

    // Weekly Leaderboard
    match /weekly_leaderboard/{leaderboardId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Leaderboard (Stats)
    match /leaderboard/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isOwner(userId);
    }

    // Academic Hierarchy
    match /academic_levels/{levelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /academic_departments/{deptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /syllabus_topics/{topicId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /study_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /curriculums/{curriculumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /curriculum/{curriculumId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Question Papers (both naming conventions)
    match /question_papers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /questionPapers/{paperId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Question Bank
    match /question_bank/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Exam Attempts & Engine Attempts
    match /exam_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /engine_exams/{examId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /engine_attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /mock_exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isTeacher();
    }

    // Audit Logs & Auth Security
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    match /auth_security/{securityId} {
      allow read, write: if true;
    }

    // Manual Approvals & System Notifications
    match /manual_approvals/{approvalId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /system_notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Question Bookmarks & Reports
    match /question_bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /question_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Points History (both naming conventions)
    match /points_history/{recordId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /pointsHistory/{recordId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Practice Results
    match /practice_results/{resultId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /results/{resultId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Subjects
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Learning Resources
    match /learning_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Sample Questions
    match /sampleQuestions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Duels
    match /duels/{duelId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Payment Audit
    match /paymentAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Security Audit
    match /securityAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // Study Challenges
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challengeDays/{dayId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challengeEnrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /challengeProgress/{progressId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // LMS Collections
    match /lms_hierarchy/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /lms_lessons/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /lms_progress/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /lms_bookmarks/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /lms_notes/{id} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Subscription Plans, Payment Plans, Coupons, Payment Methods & Receipts
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_receipts/{receiptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /refund_requests/{refundId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Forum, Discussions & Moderation
    match /forum_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forum_discussions/{discussionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /forum_replies/{replyId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /forum_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Announcements & Notifications
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notification_preferences/{userId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isOwner(userId) || isAdmin());
      allow create, update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /notification_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Documentation
    match /docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /platform_docs/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Edulpha AI Collections
    match /ai_conversations/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_messages/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_usage/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_recommendations/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_study_plans/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_quizzes/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_flashcards/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_summaries/{id} {
      allow read, write: if isAuthenticated();
    }
    match /ai_settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /ai_usage_logs/{id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Alumni Program Collections
    match /alumniProfiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alumniGallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alumniApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Student Ambassador Program Collections
    match /ambassadorProfiles/{profileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ambassadorGallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ambassadorApplications/{applicationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
