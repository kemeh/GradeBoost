{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores student and admin profile information.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name of the user." },
        "firstName": { "type": "string", "description": "First name of the user." },
        "lastName": { "type": "string", "description": "Last name of the user." },
        "email": { "type": "string", "format": "email", "description": "Email address of the user." },
        "subject": { "type": "string", "enum": ["Computer Science", "ICT"], "description": "The subject the student is studying." },
        "school": { "type": "string" },
        "region": { "type": "string" },
        "assignedPapers": { "type": "array", "items": { "type": "string" }, "description": "List of paper IDs assigned to the student." },
        "targetGrade": { "type": "string", "enum": ["A", "B", "C", "D", "F"], "description": "The student's target grade." },
        "role": { "type": "string", "enum": ["student", "admin"], "description": "The user's role in the system." },
        "hasTakenDiagnostic": { "type": "boolean", "description": "Whether the student has completed the diagnostic test." },
        "diagnosticResults": { "type": "object", "description": "Results from the diagnostic test." },
        "paymentStatus": { "type": "string", "enum": ["unpaid", "paid", "pending", "rejected"] },
        "paymentDate": { "type": "string", "format": "date-time" },
        "paymentExpiryDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user was created." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the user was last updated." }
      },
      "required": ["name", "email", "subject", "role", "createdAt"]
    },
    "PaymentAudit": {
      "title": "Payment Audit",
      "description": "Logs payment attempts and confirmations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "provider": { "type": "string", "enum": ["MTN", "Orange"] },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["initiated", "success", "failed"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "provider", "status", "timestamp"]
    },
    "QuestionPaper": {
      "title": "Question Paper",
      "description": "Stores metadata for uploaded PDF exam papers.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the question paper." },
        "year": { "type": "integer", "description": "The year of the exam session." },
        "subject": { "type": "string", "description": "The subject of the paper." },
        "paperType": { "type": "string", "description": "The type of paper (e.g., Paper 1, Paper 2)." },
        "description": { "type": "string", "description": "A brief description of the paper." },
        "pdfUrl": { "type": "string", "format": "uri", "description": "The URL to the PDF file in storage." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the paper was uploaded." },
        "uploadedBy": { "type": "string", "description": "The UID of the admin who uploaded the paper." },
        "correctAnswers": { "type": "object", "description": "Map of question numbers to correct answers (for Paper 1)." }
      },
      "required": ["title", "year", "subject", "paperType", "pdfUrl", "createdAt", "uploadedBy"]
    },
    "ExamResult": {
      "title": "Exam Result",
      "description": "Stores student answers and scores for a specific paper.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the student." },
        "paperId": { "type": "string", "description": "The ID of the question paper." },
        "subject": { "type": "string", "description": "The subject of the paper." },
        "paperType": { "type": "string", "description": "The type of paper." },
        "answers": { "type": "object", "description": "The student's answers for each question." },
        "score": { "type": "number", "description": "The student's score as a percentage." },
        "grade": { "type": "string", "description": "The grade achieved." },
        "feedback": { "type": "string", "description": "Automated feedback for the student." },
        "completedAt": { "type": "string", "format": "date-time", "description": "When the exam was submitted." }
      },
      "required": ["userId", "paperId", "subject", "paperType", "answers", "score", "grade", "completedAt"]
    },
    "ExamQuestion": {
      "title": "Exam Question",
      "description": "Stores individual exam questions for the question bank.",
      "type": "object",
      "properties": {
        "questionText": { "type": "string" },
        "options": { "type": "object", "description": "Map of options A, B, C, D." },
        "correctAnswer": { "type": "string" },
        "explanation": { "type": "string" },
        "paper": { "type": "string", "enum": ["Paper 1", "Paper 2", "Paper 3"] },
        "section": { "type": "string", "enum": ["A", "B", "C"] },
        "topic": { "type": "string" },
        "marks": { "type": "integer" },
        "difficulty": { "type": "string", "enum": ["Easy", "Medium", "Hard"] },
        "year": { "type": "integer" },
        "isDailyDrill": { "type": "boolean" },
        "imageUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["questionText", "options", "correctAnswer", "paper", "topic", "createdAt"]
    },
    "DailyDrill": {
      "title": "Daily Drill",
      "description": "Maps a day (1-365) to specific questions from the exam_questions collection.",
      "type": "object",
      "properties": {
        "day": { "type": "integer", "description": "Day number (1-365)." },
        "questionIds": { "type": "array", "items": { "type": "string" }, "description": "List of question IDs." },
        "subject": { "type": "string", "enum": ["Computer Science", "ICT"] },
        "topic": { "type": "string" },
        "isFree": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["day", "questionIds", "subject", "topic", "createdAt"]
    },
    "DrillSubmission": {
      "title": "Drill Submission",
      "description": "Stores student submissions for daily drills.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "day": { "type": "integer" },
        "selectedAnswer": { "type": "string" },
        "correctAnswer": { "type": "string" },
        "score": { "type": "number" },
        "paper": { "type": "string", "enum": ["Paper 1", "Paper 2", "Paper 3"] },
        "topic": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "questionId", "day", "selectedAnswer", "correctAnswer", "score", "createdAt"]
    },
    "SecurityAudit": {
      "title": "Security Audit",
      "description": "Logs unauthorized access attempts and security errors.",
      "type": "object",
      "properties": {
        "error": { "type": "string" },
        "operationType": { "type": "string" },
        "path": { "type": "string" },
        "authInfo": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" },
        "ip": { "type": "string" },
        "userAgent": { "type": "string" }
      },
      "required": ["error", "timestamp"]
    },
    "LearningResource": {
      "title": "Learning Resource",
      "description": "Recommended learning resources for students.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "topic": { "type": "string" },
        "link": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "topic", "link", "createdAt"]
    },
    "Resource": {
      "title": "Resource",
      "description": "Educational resources like PDFs and videos.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["PDF", "Video", "Link"] },
        "subject": { "type": "string", "enum": ["Computer Science", "ICT"] },
        "fileUrl": { "type": "string", "format": "uri" },
        "fileSize": { "type": "string" },
        "visible": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "subject", "fileUrl", "visible", "createdAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Assigned tasks for students.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "paper": { "type": "string" },
        "subject": { "type": "string", "enum": ["Computer Science", "ICT"] },
        "dueDate": { "type": "string", "format": "date-time" },
        "link": { "type": "string", "format": "uri" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "paper", "subject", "dueDate", "link", "active", "createdAt"]
    },
    "WeeklyLeaderboard": {
      "title": "Weekly Leaderboard",
      "description": "Stores weekly leaderboard rankings for students.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "totalScore": { "type": "number" },
        "position": { "type": "integer" },
        "weekNumber": { "type": "integer" },
        "year": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "totalScore", "position", "weekNumber", "year", "updatedAt"]
    },
    "Duel": {
      "title": "Duel",
      "description": "Stores duel battle sessions.",
      "type": "object",
      "properties": {
        "player1Id": { "type": "string" },
        "player2Id": { "type": "string" },
        "questions": { "type": "array", "items": { "type": "string" } },
        "player1Score": { "type": "number" },
        "player2Score": { "type": "number" },
        "player1Time": { "type": "number" },
        "player2Time": { "type": "number" },
        "winnerId": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "active", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["player1Id", "questions", "player1Score", "player2Score", "player1Time", "player2Time", "status", "createdAt"]
    },
    "LeaderboardEntry": {
      "title": "Leaderboard Entry",
      "description": "Stores student leaderboard stats.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "points": { "type": "number" },
        "wins": { "type": "integer" },
        "losses": { "type": "integer" },
        "draws": { "type": "integer" },
        "rank": { "type": "integer" }
      },
      "required": ["userId", "name", "points", "wins", "losses", "draws", "rank"]
    },
    "PointsHistory": {
      "title": "Points History",
      "description": "Logs points earned.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "points": { "type": "number" },
        "reason": { "type": "string", "enum": ["duel_win", "duel_loss", "duel_draw", "daily_drill"] },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "points", "reason", "date"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Stores user feedback on questions, explanations, or the application.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["question", "explanation", "general"] },
        "contextId": { "type": "string", "description": "Optional ID of the question or explanation." },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "rating", "createdAt"]
    },
    "SystemSettings": {
      "title": "System Settings",
      "description": "Stores global system configuration like API keys, challenge start date, and payment price.",
      "type": "object",
      "properties": {
        "geminiApiKey": { "type": "string", "description": "The active Gemini API key." },
        "challengeStartDate": { "type": "string", "format": "date", "description": "The start date of the 60-day challenge (YYYY-MM-DD)." },
        "paymentPrice": { "type": "number", "description": "The price of the premium plan in FCFA." },
        "appName": { "type": "string", "description": "The name of the application." },
        "logoUrl": { "type": "string", "description": "The URL of the application logo." },
        "contactEmail": { "type": "string", "description": "The contact email for the application." },
        "updatedAt": { "type": "string", "format": "date-time" },
        "updatedBy": { "type": "string" }
      },
      "required": ["geminiApiKey", "challengeStartDate", "paymentPrice", "updatedAt", "updatedBy"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Stores manual mobile money payment submissions.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "paymentCode": { "type": "string" },
        "transactionId": { "type": "string" },
        "network": { "type": "string", "enum": ["MTN", "Orange"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "screenshotUrl": { "type": "string", "format": "uri" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "paymentCode", "transactionId", "network", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/questionPapers/{paperId}": {
      "schema": "QuestionPaper",
      "description": "Exam paper metadata."
    },
    "/results/{resultId}": {
      "schema": "ExamResult",
      "description": "Student exam results."
    },
    "/exam_questions/{questionId}": {
      "schema": "ExamQuestion",
      "description": "Individual exam questions."
    },
    "/daily_drills/{drillId}": {
      "schema": "DailyDrill",
      "description": "Daily drill mappings."
    },
    "/drill_submissions/{submissionId}": {
      "schema": "DrillSubmission",
      "description": "Student daily drill submissions."
    },
    "/paymentAudit/{auditId}": {
      "schema": "PaymentAudit",
      "description": "Payment audit logs."
    },
    "/securityAudit/{auditId}": {
      "schema": "SecurityAudit",
      "description": "Security audit logs."
    },
    "/learning_resources/{resourceId}": {
      "schema": "LearningResource",
      "description": "Learning resources for students."
    },
    "/resources/{resourceId}": {
      "schema": "Resource",
      "description": "Educational resources."
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Student assignments."
    },
    "/weekly_leaderboard/{leaderboardId}": {
      "schema": "WeeklyLeaderboard",
      "description": "Weekly leaderboard rankings."
    },
    "/duels/{duelId}": {
      "schema": "Duel",
      "description": "Duel battle sessions."
    },
    "/leaderboard/{userId}": {
      "schema": "LeaderboardEntry",
      "description": "Student leaderboard stats."
    },
    "/pointsHistory/{recordId}": {
      "schema": "PointsHistory",
      "description": "Points earned logs."
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSettings",
      "description": "Global system settings."
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Manual mobile money payment submissions."
    },
    "/feedback/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback."
    }
  }
}
